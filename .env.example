# ============================================================================
# NoShowGuard — Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ============================================================================

# --- Supabase ---
# Found in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Resend ---
# Sign up at https://resend.com and create an API key
RESEND_API_KEY=re_your_api_key_here
# The verified "from" email address in Resend
RESEND_FROM_EMAIL=NoShowGuard <bookings@yourdomain.com>

# --- App ---
# The base URL of the app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Cron ---
# Secret token to protect the /api/cron/reminders endpoint
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here
